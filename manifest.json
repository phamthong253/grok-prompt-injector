{
  "manifest_version": 3,
  "name": "Grok Prompt Injector",
  "version": "3.0.0",
  "description": "Tự động gán nhiều prompt vào Grok Imagine và tải về khi xong.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_title": "Grok Prompt Injector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://grok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
